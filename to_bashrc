
# ==========================================
#          NETWORK UTILITY MENU
# ==========================================

# Interactive Bash only
case "$-" in
    *i*) ;;
    *) return ;;
esac

# Terminal colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

# ------------------------------------------
# SIGNAL PROTECTION
# ------------------------------------------

# Ctrl+C: Do not terminate the menu
trap 'printf "\n${RED}[!] Ctrl+C is disabled!${RESET}\n"' INT

# Ignore terminal suspend and quit signals
trap '' TSTP QUIT

# ------------------------------------------
# SAFE INPUT
# ------------------------------------------

read_input() {
    local prompt="$1"

    REPLY=""

    while true; do
        if IFS= read -r -p "$prompt" REPLY; then
            return 0
        fi

        REPLY=""
        echo
        echo -e "${RED}[!] Input interrupted or unavailable.${RESET}"
        echo -e "${YELLOW}[!] You must use the menu.${RESET}"
    done
}

pause() {
    echo
    read_input "Press Enter to return to menu..."
}

show_header() {
    clear

    echo -e "${CYAN}"
    echo "======================================"
    echo "          NETWORK UTILITIES"
    echo "======================================"
    echo -e "${RESET}"
}

# ------------------------------------------
# 1. IP ADDRESS INFORMATION
# ------------------------------------------

ip_information() {
    show_header

    echo -e "${GREEN}Network Interfaces${RESET}"
    echo

    ip -br address

    echo
    echo "--------------------------------------"
    echo "Routing Table:"
    echo "--------------------------------------"

    ip route

    pause
}

# ------------------------------------------
# 2. PING
# ------------------------------------------

ping_server() {
    show_header

    echo -e "${GREEN}PING TOOL${RESET}"
    echo

    read_input "Enter IP or Domain: "
    target="$REPLY"

    if [[ ! "$target" =~ ^[a-zA-Z0-9._:-]+$ ]]; then
        echo -e "${RED}Invalid target!${RESET}"
        pause
        return
    fi

    echo
    echo -e "${YELLOW}Pinging $target ...${RESET}"
    echo

    ping -c 4 -- "$target"

    pause
}

# ------------------------------------------
# 3. NETCAT PORT CHECK
# ------------------------------------------

netcat_check() {
    show_header

    echo -e "${GREEN}NETCAT PORT CHECKER${RESET}"
    echo

    read_input "Enter Server IP/Domain: "
    host="$REPLY"

    read_input "Enter Port Number: "
    port="$REPLY"

    if [[ ! "$host" =~ ^[a-zA-Z0-9._:-]+$ ]]; then
        echo -e "${RED}Invalid hostname!${RESET}"
        pause
        return
    fi

    if [[ ! "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
        echo -e "${RED}Invalid port!${RESET}"
        pause
        return
    fi

    if ! command -v nc >/dev/null 2>&1; then
        echo -e "${RED}Netcat is not installed!${RESET}"
        pause
        return
    fi

    echo
    echo -e "${YELLOW}Checking $host:$port ...${RESET}"
    echo

    nc -vz -w 3 "$host" "$port"

    pause
}

# ------------------------------------------
# 4. DNS LOOKUP
# ------------------------------------------

dns_lookup() {
    show_header

    echo -e "${GREEN}DNS LOOKUP${RESET}"
    echo

    read_input "Enter Domain Name: "
    domain="$REPLY"

    if [[ ! "$domain" =~ ^[a-zA-Z0-9.-]+$ ]]; then
        echo -e "${RED}Invalid domain!${RESET}"
        pause
        return
    fi

    echo
    echo -e "${YELLOW}Resolving $domain ...${RESET}"
    echo

    if command -v dig >/dev/null 2>&1; then

        echo "A Records:"
        dig +short "$domain" A

        echo
        echo "AAAA Records:"
        dig +short "$domain" AAAA

        echo
        echo "MX Records:"
        dig +short "$domain" MX

        echo
        echo "NS Records:"
        dig +short "$domain" NS

    elif command -v getent >/dev/null 2>&1; then

        echo "Resolved Addresses:"
        getent ahosts "$domain"

    else
        echo -e "${RED}DNS tools unavailable!${RESET}"
    fi

    pause
}

# ------------------------------------------
# MAIN MENU
# ------------------------------------------

while true; do

    show_header

    echo -e "${GREEN}1.${RESET} IP Address Information"
    echo -e "${GREEN}2.${RESET} Ping"
    echo -e "${GREEN}3.${RESET} Netcat Port Checker"
    echo -e "${GREEN}4.${RESET} DNS Lookup"

    echo
    echo -e "${RED}0.${RESET} Exit"

    echo
    echo "======================================"

    read_input "Select an option: "
    choice="$REPLY"

    case "$choice" in

        1)
            ip_information
            ;;

        2)
            ping_server
            ;;

        3)
            netcat_check
            ;;

        4)
            dns_lookup
            ;;

        0)
            clear
            echo -e "${GREEN}Logging out...${RESET}"
            exit 0
            ;;

        *)
            echo
            echo -e "${RED}Invalid option! Try again.${RESET}"
            sleep 2
            ;;

    esac

done
